# VAULTED Environment Configuration Template
# Copy this file to `.env` and fill in your keys:
#   cp .env.example .env

# 1. Steam Web API (Required for Steam inventory sync & CS2/Dota items)
# Get a free key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# 2. Google Gemini API (Required for Agentic Valto Chat Sentinel & Receipt OCR)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Polygon Testnet RPC (Free public RPC for on-chain telemetry)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology

# 4. Exchange Rate API (Free live currency rates)
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
