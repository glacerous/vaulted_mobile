# ==============================================================================
# VAULTED — Environment Configuration Reference
# Duplicate this file as .env and fill in your real credentials.
# ==============================================================================

# 1. Google Gemini AI (Receipt OCR & Warranty Prediction)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Steam Web API (CS2 Drops & Community Market Liquidity)
# Get a free key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# 3. Pokémon TCG API (Collectible Set Releases & Card Valuations)
# Optional free key at: https://pokemontcg.io/ (Works without key at 20k req/day)
POKEMON_TCG_API_KEY=your_pokemon_tcg_api_key_here

# 4. CoinGecko API (Crypto Trending Drops & Floor Prices)
# Optional Demo API key: https://www.coingecko.com/en/api (Public endpoint works without key)
COINGECKO_API_KEY=your_coingecko_api_key_here

# 5. Polygon Amoy Web3 RPC (Cryptographic Asset Verification & Wallet Sync)
# Public testnet endpoint (no key required):
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_CHAIN_ID=80002

# 6. Currency Exchange Rate API (Multi-currency USD/IDR/EUR/GBP conversion)
# Free open endpoint (no key required):
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# 7. Device Calendar Deep Link (Optional custom calendar prefix)
CALENDAR_SYNC_ENABLED=true
